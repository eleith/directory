{
	"name": "directory",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=26.5.0 <27",
		"pnpm": "11.9.0"
	},
	"scripts": {
		"schema:generate": "pnpm --filter @directory/config schema:generate",
		"schema:check": "pnpm --filter @directory/config schema:check",
		"build:packages": "pnpm --filter './packages/*' -r build",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm -r test",
		"test:coverage": "pnpm -r test:coverage",
		"test:e2e": "pnpm --filter @directory/web test:e2e",
		"verify": "pnpm schema:check && pnpm build && pnpm check && pnpm lint && pnpm test:coverage && pnpm test:e2e",
		"dev": "pnpm build:packages && pnpm --filter @directory/web dev",
		"cli": "pnpm build:packages && pnpm --filter @directory/cli build && node apps/cli/dist/index.js",
		"changeset": "changeset",
		"version:apps": "changeset version",
		"tag:apps": "changeset git-tag"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@eslint/js": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
