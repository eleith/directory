{
	"additionalProperties": false,
	"title": "Directory configuration",
	"type": "object",
	"required": ["links"],
	"properties": {
		"version": { "default": 1, "const": 1, "type": "number" },
		"site": { "default": {}, "$ref": "#/$defs/Site" },
		"appearance": { "default": {}, "$ref": "#/$defs/Appearance" },
		"auth": { "$ref": "#/$defs/Auth" },
		"links": {
			"additionalProperties": false,
			"description": "Links keyed by stable, non-numeric lowercase slugs. An empty map is allowed.",
			"type": "object",
			"patternProperties": {
				"^(?![0-9]+(?![\\s\\S]))(?!(?:prototype|constructor)(?![\\s\\S]))[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])": {
					"default": {},
					"$ref": "#/$defs/Link"
				}
			}
		}
	},
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"HttpUrl": {
			"description": "An absolute HTTP or HTTPS URL. Relative and executable URLs are not accepted.",
			"type": "string",
			"anyOf": [
				{ "type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s]+$" },
				{
					"type": "string",
					"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
				}
			]
		},
		"SiteUrl": {
			"description": "The canonical public HTTP(S) origin of Directory. No credentials, path, trailing slash, query, fragment, or noncanonical URL spelling. Authentication requires HTTPS except for http://localhost[:port]. Omitted values use localhost with PORT, or 5173 in development and 3000 otherwise.",
			"type": "string",
			"anyOf": [
				{
					"type": "string",
					"format": "uri",
					"pattern": "^(?:https://(?:[^\\s/\\\\?#@:\\[\\]A-Z%]+|\\[[0-9a-f:.]+\\])(?::(?!443(?![\\s\\S]))[1-9][0-9]*)?|http://(?:[^\\s/\\\\?#@:\\[\\]A-Z%]+|\\[[0-9a-f:.]+\\])(?::(?!80(?![\\s\\S]))[1-9][0-9]*)?)(?![\\s\\S])"
				},
				{
					"type": "string",
					"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
				}
			]
		},
		"AuthSecret": {
			"description": "An optional user-generated random session secret of at least 32 characters. Omit to let the server generate an ephemeral secret at startup; the config loader does not generate one.",
			"type": "string",
			"anyOf": [
				{ "type": "string", "pattern": "\\S", "minLength": 32 },
				{
					"type": "string",
					"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
				}
			]
		},
		"LocalImagePath": {
			"description": "A decoded image path under /public/. Use SVG, PNG, JPEG, GIF or WebP; no dot segments, percent escapes, backslashes, queries or fragments.",
			"type": "string",
			"anyOf": [
				{
					"type": "string",
					"pattern": "^/public/(?:(?!\\.{1,2}(?:/|$))[^/%\\\\?#\\x00-\\x1f\\x7f]+/)*(?!\\.{1,2}(?:/|$))[^/%\\\\?#\\x00-\\x1f\\x7f]+\\.(?:[sS][vV][gG]|[pP][nN][gG]|[jJ][pP][eE]?[gG]|[gG][iI][fF]|[wW][eE][bB][pP])(?![\\s\\S])"
				},
				{
					"type": "string",
					"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
				}
			]
		},
		"SiteImagePath": {
			"description": "A mounted image path or the bundled /favicon.png mark.",
			"anyOf": [
				{ "$ref": "#/$defs/LocalImagePath" },
				{
					"type": "string",
					"anyOf": [
						{ "type": "string", "const": "/favicon.png" },
						{
							"type": "string",
							"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
						}
					]
				}
			]
		},
		"HexColor": {
			"description": "A three- or six-digit hexadecimal color.",
			"type": "string",
			"anyOf": [
				{ "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})(?![\\s\\S])" },
				{
					"type": "string",
					"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
				}
			]
		},
		"Tags": {
			"description": "A list of labels. Commas inside a label are literal; an empty list means no tags.",
			"type": "array",
			"items": {
				"type": "string",
				"anyOf": [
					{ "type": "string", "pattern": "^[^\\x00-\\x1f\\x7f]*(?![\\s\\S])" },
					{
						"type": "string",
						"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
					}
				]
			}
		},
		"Link": {
			"additionalProperties": false,
			"type": "object",
			"required": ["title", "url"],
			"properties": {
				"title": {
					"description": "Visible name of this link.",
					"type": "string",
					"anyOf": [
						{ "type": "string", "pattern": "\\S", "minLength": 1 },
						{
							"type": "string",
							"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
						}
					]
				},
				"url": { "$ref": "#/$defs/HttpUrl" },
				"description": { "description": "Plain text; multiline is supported.", "type": "string" },
				"logo_path": { "$ref": "#/$defs/LocalImagePath" },
				"tags": { "default": [], "$ref": "#/$defs/Tags" },
				"group": {
					"description": "Optional display group label.",
					"type": "string",
					"anyOf": [
						{ "type": "string", "pattern": "\\S", "minLength": 1 },
						{
							"type": "string",
							"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
						}
					]
				},
				"requires_auth": {
					"default": false,
					"description": "Service sign-in hint only; does not enable Directory authentication.",
					"type": "boolean"
				},
				"internal_only": {
					"default": false,
					"description": "LAN/VPN availability hint only; does not check or restrict network access.",
					"type": "boolean"
				},
				"admin_only": {
					"default": false,
					"description": "Intended-for-administrators hint only; does not hide the link or enforce a role.",
					"type": "boolean"
				}
			}
		},
		"Site": {
			"additionalProperties": false,
			"type": "object",
			"properties": {
				"url": { "default": "http://localhost:3000", "$ref": "#/$defs/SiteUrl" },
				"title": {
					"default": "Directory",
					"type": "string",
					"anyOf": [
						{ "type": "string", "pattern": "\\S", "minLength": 1 },
						{
							"type": "string",
							"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
						}
					]
				},
				"description": { "default": "", "type": "string" },
				"logo_path": { "default": "/favicon.png", "$ref": "#/$defs/SiteImagePath" },
				"favicon_path": { "default": "/favicon.png", "$ref": "#/$defs/SiteImagePath" },
				"og_image_path": {
					"description": "Optional public Open Graph image, including when authentication is enabled. Use a /public/ image path, not an external URL; PNG or JPEG at 1200×630 is recommended. Omit or supply a missing image to generate a 1200×630 PNG from the site title, favicon and appearance only.",
					"$ref": "#/$defs/LocalImagePath"
				},
				"footer": { "default": "", "type": "string" },
				"open_links_in_new_tab": {
					"default": true,
					"description": "Open service links in a new tab instead of the current tab.",
					"type": "boolean"
				}
			}
		},
		"Appearance": {
			"additionalProperties": false,
			"type": "object",
			"properties": {
				"primary_light_color": { "default": "#0f766e", "$ref": "#/$defs/HexColor" },
				"primary_dark_color": { "default": "#5eead4", "$ref": "#/$defs/HexColor" }
			}
		},
		"OidcAuth": {
			"additionalProperties": false,
			"type": "object",
			"required": ["issuer", "client_id", "client_secret"],
			"properties": {
				"issuer": { "$ref": "#/$defs/HttpUrl" },
				"client_id": {
					"type": "string",
					"anyOf": [
						{ "type": "string", "pattern": "\\S", "minLength": 1 },
						{
							"type": "string",
							"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
						}
					]
				},
				"client_secret": {
					"type": "string",
					"anyOf": [
						{ "type": "string", "minLength": 1 },
						{
							"type": "string",
							"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
						}
					]
				}
			}
		},
		"CredentialsAuth": {
			"additionalProperties": false,
			"type": "object",
			"required": ["username", "password"],
			"properties": {
				"username": {
					"type": "string",
					"anyOf": [
						{ "type": "string", "pattern": "\\S", "minLength": 1 },
						{
							"type": "string",
							"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
						}
					]
				},
				"password": {
					"type": "string",
					"anyOf": [
						{ "type": "string", "minLength": 1 },
						{
							"type": "string",
							"pattern": "(?:^|[^$])(?:\\$\\$)*\\$\\{[A-Z_][A-Z0-9_]*(?::-[^}]*)?\\}"
						}
					]
				}
			}
		},
		"Auth": {
			"description": "Declare exactly one strategy, or omit auth for an open dashboard.",
			"anyOf": [
				{
					"additionalProperties": false,
					"title": "OIDC",
					"type": "object",
					"required": ["oidc"],
					"properties": {
						"secret": { "$ref": "#/$defs/AuthSecret" },
						"oidc": { "$ref": "#/$defs/OidcAuth" },
						"credentials": { "not": {} }
					}
				},
				{
					"additionalProperties": false,
					"title": "Shared username and password",
					"type": "object",
					"required": ["credentials"],
					"properties": {
						"secret": { "$ref": "#/$defs/AuthSecret" },
						"credentials": { "$ref": "#/$defs/CredentialsAuth" },
						"oidc": { "not": {} }
					}
				}
			]
		}
	}
}
