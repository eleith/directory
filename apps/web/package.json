{
	"name": "@directory/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"files": [
		"build"
	],
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --ignore-path ../../.prettierignore --check . && eslint .",
		"format": "prettier --ignore-path ../../.prettierignore --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@dicebear/core": "10.4.0",
		"@directory/config": "workspace:*",
		"tslog": "5.2.0"
	},
	"devDependencies": {
		"@auth/sveltekit": "1.11.3",
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-node": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
