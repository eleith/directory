# Copy to .env beside the Compose files. Never commit real secrets.
# No-auth configurations require no session secret.
# If auth is enabled, set your own random AUTH_SECRET of at least 32 characters;
# there is no shared fallback. Generate once with: openssl rand -base64 32
# Save the result below in your ignored .env before starting Compose.
# AUTH_SECRET=
# For the isolated local review demo, see demo/README.md at the repository root.

# For production behind your HTTPS proxy, set the public root origin.
# Leave unset for local review: Compose selects localhost:3000 or localhost:5173.
# Compose sets AUTH_URL to this same origin.
# ORIGIN=https://directory.example.com

# Optional values for custom YAML that references them.
# DIRECTORY_PASSWORD=
# DIRECTORY_OIDC_CLIENT_SECRET=

# Optional image source and host-port overrides.
# DIRECTORY_IMAGE=ghcr.io/eleith/directory:latest
# DIRECTORY_PORT=3000
# DIRECTORY_BIND=127.0.0.1

# Development containers use your host identity; override if it is not 1000:1000.
# LOCAL_UID=1000
# LOCAL_GID=1000
