{
	"name": "@where/cli",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/cli.d.ts",
			"import": "./dist/cli.js"
		}
	},
	"bin": {
		"where": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && esbuild src/index.ts src/cli.ts --bundle --platform=neutral --format=esm --target=node26 --outdir=dist --main-fields=module,main --conditions=import --external:node:*",
		"check": "tsc --noEmit -p tsconfig.json",
		"lint": "prettier --ignore-path ../../.prettierignore --check . && eslint .",
		"format": "prettier --ignore-path ../../.prettierignore --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@where/config": "workspace:*",
		"gunshi": "0.35.1"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"esbuild": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
